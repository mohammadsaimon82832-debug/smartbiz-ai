# Copy this file to .env and fill in your values. Never commit .env.

# Ollama native local inference (no cloud credentials required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# SQLite database file (created automatically)
SMARTBIZ_DB=smartbiz.db

# Label used by the AI when it writes money amounts (e.g. USD, BDT, EUR)
BUSINESS_CURRENCY=USD

# Optional: if set, every /api request must send this value in the X-API-Key header
SMARTBIZ_API_TOKEN=
